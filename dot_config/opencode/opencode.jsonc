{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    // Allow by default, deny only irreversible categories.
    // See ~/.agents/permissions-theory.md
    "edit": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      // Destructive system operations
      "rm -rf / *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~ *": "deny",
      "rm -rf $HOME *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "chmod 000 *": "deny",
      "chmod -R *": "deny",
      "chown *": "deny",
      "dd if=*": "deny",
      "kill -9 *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "halt *": "deny",
      "poweroff *": "deny",
      // Network egress tools
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      // Remote git mutation
      "git push *": "deny",
      "git lfs push *": "deny",
      // Package/container publication
      "docker push *": "deny",
      "podman push *": "deny",
      "npm publish *": "deny",
      "uv publish *": "deny",
      "pnpm publish *": "deny",
      "yarn publish *": "deny",
      "yarn npm publish *": "deny",
      "cargo publish *": "deny",
      "dotnet nuget push *": "deny",
      // Release creation
      "gh release *": "deny",
      "cargo release *": "deny",
      // Direct database mutation
      "psql *": "deny",
      "mysql *": "deny"
    },
    "external_directory": {
      "*": "allow",
      // Credential files
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny"
    }
  },
  "mcp": {
    "forge-knowledge": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/forge/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    }
  },
  "plugin": [
    "/Users/ibuchanan/dev/git/github.com/plastic-labs/opencode-honcho/honcho-ai-opencode-honcho-0.1.0.tgz",
    "/Users/ibuchanan/dev/git/github.com/plastic-labs/opencode-honcho",
  ]
}
