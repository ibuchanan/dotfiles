{
	"agent": {
		"default_model": {
			"model": "gpt-4.1",
			"provider": "copilot_chat"
		},
		"default_profile": "ask",
		"dock": "right",
		"model_parameters": []
	},
	"agent_servers": {},
	"buffer_font_size": 16,
	"cli_default_open_behavior": "new_window",
	"collaboration_panel": {
		"dock": "left"
	},
	"disable_ai": false,
	"format_on_save": "on",
	"git_panel": {
		"dock": "left"
	},
	"languages": {
		"CSS": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSON": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSONC": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JavaScript": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TSX": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		}
	},
	"lsp": {
		"biome": {
			"binary": {
				"arguments": ["lsp-proxy"],
				"path": "~/.bun/bin/biome"
			}
		}
	},
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left"
	},
	"ssh_connections": [],
	"theme": {
		"dark": "One Dark",
		"light": "One Light",
		"mode": "system"
	},
	"ui_font_size": 16
}
